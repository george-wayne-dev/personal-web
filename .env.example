# Copy to .env.local, then point to your own private content if needed.
# Keep unset to use the repository's content/ directory.
# CONTENT_ROOT=/absolute/path/to/personal-content/content
# SITE_CONFIG_PATH=/absolute/path/to/personal-content/site.json
# Drafts are visible in development and always excluded from production builds.

# Public canonical origin, also set this in the hosting build environment.
# SITE_URL=https://your-project.pages.dev
